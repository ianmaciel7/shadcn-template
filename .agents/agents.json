{
  "schemaVersion": 4,
  "instructions": {
    "path": "AGENTS.md"
  },
  "integrations": {
    "enabled": [
      "codex",
      "claude",
      "claude_desktop",
      "gemini",
      "cursor",
      "antigravity"
    ],
    "options": {
      "cursorAutoApprove": true,
      "antigravityGlobalSync": true,
      "claudeScope": "project",
      "copilotCliPath": ".mcp.json"
    }
  },
  "syncMode": "source-only",
  "mcp": {
    "servers": {
      "serena": {
        "transport": "stdio",
        "enabled": true,
        "description": "Project-local semantic symbol analysis",
        "command": "serena",
        "args": [
          "start-mcp-server",
          "--project-from-cwd",
          "--context=codex"
        ]
      },
      "next-devtools": {
        "transport": "stdio",
        "enabled": true,
        "description": "Next.js runtime diagnostics and route inspection",
        "command": "pnpm",
        "args": [
          "exec",
          "next-devtools-mcp"
        ]
      }
    }
  },
  "workspace": {
    "vscode": {
      "hideGenerated": true,
      "hiddenPaths": [
        "**/.codex",
        "**/.claude",
        "**/.gemini",
        "**/.cursor",
        "**/.antigravity",
        "**/.agents/mcp_config.json",
        "**/.windsurf",
        "**/.opencode",
        "**/.junie",
        "**/.mcp.json",
        "**/opencode.json",
        "**/.agents/generated",
        "**/.grok",
        "**/.amp",
        "**/.factory",
        "**/.kilo",
        "**/kilo.jsonc",
        "**/.devin",
        "**/.zed"
      ]
    }
  },
  "lastSync": null,
  "lastSyncSourceHash": null,
  "activeProfile": null
}
