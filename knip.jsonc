{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // src/components is the template's public component library, so every file
  // there is an entry point. Application code (hooks, lib, i18n) is NOT listed
  // here: it is only reachable through routes, components, stories or tests, so
  // genuinely unused application code is still reported.
  "entry": [
    "src/app/{page,layout,loading,error,not-found,route}.{ts,tsx}",
    "src/components/**/*.{ts,tsx}",
    "src/**/*.stories.{ts,tsx}"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  // ADR 0004 specifies these as part of the accepted i18n design
  // (path-based navigation helpers and the re-exported routing members), so
  // they are kept intentionally even though no route uses them yet.
  "ignoreFiles": ["src/i18n/navigation.ts"],
  "ignoreIssues": {
    "src/i18n/routing.ts": ["exports"]
  },
  "ignoreDependencies": [
    // Referenced only from CSS, which Knip does not follow.
    "shadcn",
    "tailwindcss",
    "tw-animate-css",
    // Launched by .agents/agents.json as an MCP server.
    "next-devtools-mcp",
    // Accepted by ADR 0007 but without a suitable subject yet: no ast-grep
    // rules exist and no jsdom component test needs these helpers.
    "@ast-grep/cli",
    "@testing-library/jest-dom",
    "@testing-library/user-event"
  ],
  // Host tools installed outside pnpm (see TOOLING.md).
  "ignoreBinaries": ["semgrep", "gitleaks"]
}
