language js;

or {
  `export const metadata: $_ = $_` as $export,
  `export const metadata = $_` as $export
} where {
  register_diagnostic(
    span = $export,
    message = "Avoid static metadata exports with hardcoded text. Use `generateMetadata()` with `getTranslations()` for internationalization.",
    severity = "error"
  )
}
