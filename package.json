{
  "name": "shadcn-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.19.0 || ^24.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "setup:github": "node scripts/setup-github.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:ci": "biome ci",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs -- src",
    "check:unused": "knip",
    "check:duplicates": "jscpd --config .jscpd.json",
    "check:structure": "ast-grep test && ast-grep scan",
    "check:spelling": "cspell lint \"**/*.{ts,tsx,md,json}\" --no-progress",
    "check:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.next\"",
    "check:security": "semgrep scan --config tests/semgrep/rules.yml --error --metrics=off --disable-version-check src next.config.ts",
    "check:security:rules": "semgrep --test tests/semgrep",
    "check:secrets": "gitleaks git --no-banner --redact",
    "check:workflows": "actionlint && zizmor .github/workflows",
    "audit": "pnpm audit",
    "verify:fast": "pnpm lint:ci && pnpm typecheck && pnpm test",
    "verify:static": "pnpm lint:ci && pnpm typecheck && pnpm test:coverage && pnpm check:architecture && pnpm check:unused && pnpm check:duplicates && pnpm check:structure && pnpm check:spelling && pnpm check:markdown && pnpm analyze:fallow && pnpm analyze:react",
    "verify:build": "pnpm test:browser && pnpm analyze:size && pnpm ladle:build",
    "verify:full": "pnpm verify:static && pnpm verify:build",
    "verify:security": "pnpm check:security:rules && pnpm check:security && pnpm check:secrets && pnpm check:workflows && pnpm audit",
    "verify:e2e": "playwright test",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test --grep-invert \"@a11y|@visual\"",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",
    "test:mutation": "stryker run",
    "analyze:react": "react-doctor --no-score --no-telemetry --no-supply-chain",
    "analyze:bundle": "next experimental-analyze",
    "analyze:size": "next build && size-limit",
    "analyze:lighthouse": "node -e \"require('node:fs').mkdirSync('reports/lighthouse',{recursive:true})\" && lighthouse http://127.0.0.1:3000 --output=html --output-path=reports/lighthouse/report.html --chrome-flags=\"--headless\"",
    "analyze:lighthouse:ci": "node -e \"require('node:fs').mkdirSync('reports/lighthouse',{recursive:true})\" && lighthouse http://127.0.0.1:3000 --output=html --output-path=reports/lighthouse/report.html --chrome-flags=\"--headless --no-sandbox\"",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "prepare": "husky",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "analyze:fallow": "fallow health --coverage coverage/coverage-final.json",
    "analyze:health": "pnpm test:coverage && pnpm analyze:fallow"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@rive-app/react-webgl2": "^4.37.1",
    "@shadcn/react": "^0.3.1",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.154",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.61.0",
    "media-chrome": "^4.19.4",
    "motion": "^14.6.0",
    "nanoid": "^6.0.2",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-jsx-parser": "^2.4.1",
    "react-resizable-panels": "^4.15.0",
    "recharts": "3.10.1",
    "shadcn": "^4.22.1",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.1",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@cspell/dict-pt-br": "2.4.4",
    "@ladle/react": "5.1.1",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "14.2.0",
    "@stryker-mutator/core": "10.0.0",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "cspell": "10.4.0",
    "dependency-cruiser": "18.6.0",
    "fallow": "^3.33.1",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "jscpd": "5.4.1",
    "jsdom": "^30.1.3",
    "knip": "6.41.0",
    "lighthouse": "13.5.0",
    "lint-staged": "16.4.0",
    "markdownlint-cli2": "0.23.3",
    "next-devtools-mcp": "0.4.0",
    "react-doctor": "^0.9.18",
    "size-limit": "14.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "2.3.0"
  },
  "packageManager": "pnpm@12.11.2"
}
