{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "plugins": [
    "./.biome/rules/nextjs/prefer-layout-props.grit",
    "./.biome/rules/nextjs/prefer-page-props.grit",
    "./.biome/rules/nextjs/prefer-route-context.grit"
  ],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!.agents",
      "!.claude",
      "!.serena"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noJsxLiterals": {
          "level": "error",
          "options": {
            "ignoreProps": true
          }
        }
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/components/ai-elements/**",
        "src/components/ui/**",
        "src/lib/highlighter.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "useAriaPropsForRole": "off",
            "useAnchorContent": "off",
            "noLabelWithoutControl": "off",
            "noNoninteractiveTabindex": "off",
            "useKeyWithClickEvents": "off",
            "noRedundantRoles": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDoubleEquals": "off",
            "noDocumentCookie": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off",
            "noUnusedImports": "off"
          },
          "performance": {
            "noImgElement": "off"
          },
          "style": {
            "noDefaultExport": "error",
            "noJsxLiterals": "off",
            "useExportType": "error",
            "useExportsLast": "error"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.stories.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "useExportsLast": "off"
          }
        }
      }
    }
  ]
}
