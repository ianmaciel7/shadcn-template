{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/{page,layout,loading,error,not-found,route}.{ts,tsx}",
    "src/components/**/*.{ts,tsx}",
    "src/hooks/**/*.{ts,tsx}",
    "src/lib/**/*.{ts,tsx}",
    "src/i18n/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreDependencies": [
    "@ast-grep/cli",
    "@axe-core/playwright",
    "@testing-library/jest-dom",
    "@testing-library/user-event",
    "chrome-launcher",
    "fast-check",
    "next-devtools-mcp",
    "tailwindcss",
    "shadcn",
    "tw-animate-css",
    "vitest-browser-react"
  ],
  "ignoreBinaries": ["semgrep", "react-doctor"]
}
